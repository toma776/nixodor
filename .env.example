# Copiază în .env.local (local) și în variabilele proiectului Vercel. .env.local nu intră în git.

# Supabase → Project Settings → Database → Connection string → Session pooler (cu parola bazei)
DATABASE_URL=postgresql://postgres.cuxyrwbgpaiwxfqcxvgs:[PAROLA]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API Keys → cheia secretă (sb_secret_…) sau service_role
SUPABASE_SECRET_KEY=

# Opțional: se deduce din DATABASE_URL
# SUPABASE_URL=https://cuxyrwbgpaiwxfqcxvgs.supabase.co

# Doar pe Vercel: cheia cu care Vercel Cron cheamă /api/manage/cron/tick (Vercel o trimite singur)
# CRON_SECRET=

# Doar la lansare: permite indexarea site-ului online
# NIXODOR_INDEX=1
